// Generated by CMake from xpeccy.rc.in. Don't edit, don't commit.
// Absolute icon path: this file is built from the binary dir.

app	ICON	"@CMAKE_SOURCE_DIR@/images/@PROJECT_NAME@.ico"

// the application manifest (RT_MANIFEST, id 1): UTF-8 code page
1	24	"@CMAKE_SOURCE_DIR@/xpeccy.manifest"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,0,0
FILEOS 0x40004L				// VOS_NT_WINDOWS32
FILETYPE 0x1L				// VFT_APP
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"	// english (US), unicode
		BEGIN
			VALUE "CompanyName", "Oleksandr Kovalchuk"
			VALUE "FileDescription", "ZX Spectrum emulator with a debugger"
			VALUE "FileVersion", "@XVER@"
			VALUE "InternalName", "@PROJECT_NAME@"
			VALUE "LegalCopyright", "Xpeccy (c) SAM style, Xpeccy+ changes (c) Oleksandr Kovalchuk. MIT license"
			VALUE "OriginalFilename", "@PROJECT_NAME@.exe"
			VALUE "ProductName", "Xpeccy+"
			VALUE "ProductVersion", "@XVER@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
