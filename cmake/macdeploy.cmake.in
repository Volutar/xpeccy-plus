# Turns the installed .app into one that runs on a Mac that has neither Qt nor
# SDL: Qt frameworks and plugins, the SDL3 library the SDL2 shim loads by hand,
# and a signature over the result. Configured from CMakeLists.txt.
#
# install(SCRIPT) runs a script with no policy settings at all, so an if() on a
# variable holding ON/OFF would be read as a variable name. Hence the line
# below - it is not decoration.

cmake_minimum_required(VERSION 3.21)

set(BUNDLE "${CMAKE_INSTALL_PREFIX}/@PROJECT_NAME@.app")
set(FRAMEWORKS "${BUNDLE}/Contents/Frameworks")

# Two kinds of noise from this are expected and harmless: "Cannot resolve rpath"
# for the plugins dropped below, and a codesign complaint about the signature
# macdeployqt itself invalidated by rewriting install names. The bundle is
# signed again at the end.
message(STATUS "macdeployqt: ${BUNDLE}")
execute_process(COMMAND "@MACDEPLOYQT@" "${BUNDLE}" -always-overwrite COMMAND_ERROR_IS_FATAL ANY)

# What Homebrew calls "sdl2" is sdl2-compat: a shim that dlopens SDL3 while it
# is being loaded itself. macdeployqt only follows what the linker recorded, so
# SDL3 never makes it into the bundle and the app dies in a modal alert before
# main() ever runs. Among the places the shim looks is @loader_path/libSDL3.dylib,
# which is next to the shim itself.

file(GLOB SDL2_DYLIB "${FRAMEWORKS}/libSDL2*.dylib")
if(SDL2_DYLIB)
	file(STRINGS "${SDL2_DYLIB}" SDL2_IS_SHIM REGEX "Failed loading SDL3 library" LIMIT_COUNT 1)
endif()

if(SDL2_IS_SHIM)
	if(NOT EXISTS "@SDL3_LIBRARY@")
		message(FATAL_ERROR "SDL2 is the sdl2-compat shim, but SDL3 was not found - the bundle would not start")
	endif()
	message(STATUS "sdl2-compat: adding @SDL3_LIBRARY@")
	file(COPY_FILE "@SDL3_LIBRARY@" "${FRAMEWORKS}/libSDL3.dylib")
	# COPY_FILE copies the permissions too, and a Homebrew keg file is read-only:
	# xattr -cr below would then fail on it and take the install with it.
	execute_process(COMMAND chmod u+w "${FRAMEWORKS}/libSDL3.dylib" COMMAND_ERROR_IS_FATAL ANY)
endif()

# macdeployqt copies a fixed set of plugins regardless of what the binary uses,
# and here it cannot even resolve their dependencies - QtSvg, QtPdf, QtWebP and
# QtVirtualKeyboard are missing from Homebrew's Qt or live behind an @rpath it
# does not know, so those plugins would sit in the bundle unable to load. The
# reasoning per entry is the same as on Windows, see cmake/windeploy.cmake.in.

if(@TRIMDEPLOY@)
	set(PLUGINS "${BUNDLE}/Contents/PlugIns")
	foreach(d iconengines networkinformation tls platforminputcontexts)
		file(REMOVE_RECURSE "${PLUGINS}/${d}")
	endforeach()
	# jpg is one of the screenshot formats; png and bmp are built into QtGui
	file(GLOB imgplugins "${PLUGINS}/imageformats/*.dylib")
	foreach(f ${imgplugins})
		get_filename_component(n "${f}" NAME)
		if(NOT n STREQUAL "libqjpeg.dylib")
			file(REMOVE "${f}")
		endif()
	endforeach()
endif()

# Signing comes last: install_name_tool invalidates the ad-hoc signature the
# linker puts on an arm64 binary, macOS refuses to start one without it, and
# removing a plugin after signing would invalidate it again.
#
# Extended attributes first - quarantine flags and Finder information make
# codesign fail with "resource fork, Finder information, or similar detritus
# not allowed". Never in CI, where every file comes from a fresh checkout, but
# easily in a local build whose sources arrived in a downloaded archive.
execute_process(COMMAND xattr -cr "${BUNDLE}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND codesign --force --deep --sign - "${BUNDLE}" COMMAND_ERROR_IS_FATAL ANY)
