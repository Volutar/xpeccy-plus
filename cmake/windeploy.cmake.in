# Install-time step for Windows: pulls the Qt runtime into the staged folder and
# then drops the parts windeployqt copies unconditionally but this app never uses.
# Generated by CMake from cmake/windeploy.cmake.in - don't edit the build-dir copy.

# An install(SCRIPT) runs with no policy settings of its own, so without this
# CMP0012 stays OLD and if(NOT ON) reads ON as an undefined variable name.
cmake_minimum_required(VERSION 3.5)
# paths normalized before the exclude patterns below; without it CMake 4.2 and later
# warn once for every DLL looked at
if(POLICY CMP0207)
	cmake_policy(SET CMP0207 NEW)
endif()

set(APP "${CMAKE_INSTALL_PREFIX}/@PROJECT_NAME@.exe")

if(NOT EXISTS "${APP}")
	message(FATAL_ERROR "No binary to deploy: ${APP}")
endif()

# NOTE: do NOT add --release. For MinGW windeployqt decides debug/release by the
# IMAGE_FILE_DEBUG_STRIPPED flag, which marks every stock Qt plugin as "debug";
# with an explicit --release they all get filtered out and it fails with
# "Unable to find the platform plugin". Auto-detection stays self-consistent.
execute_process(
	COMMAND "@WINDEPLOYQT@" --compiler-runtime --no-translations "${APP}"
	RESULT_VARIABLE res
	OUTPUT_QUIET
)
if(NOT res EQUAL 0)
	message(FATAL_ERROR "windeployqt failed (${res})")
endif()

if(@TRIMDEPLOY@)

# windeployqt deploys a fixed set regardless of what the binary imports.
# Everything dropped below was verified unused by running the trimmed build:
#   bearer        - Qt5 bearer management, needed by QNetworkAccessManager;
#                   this app talks over plain QTcpServer/QTcpSocket
#   iconengines   - SVG icon engine, and xpeccy.qrc holds no .svg at all
#   Qt[56]Svg.dll - same reason
#   networkinformation, tls - Qt6 only; TLS backends serve QSslSocket, never used
#   ANGLE + opengl32sw - the OpenGL fallbacks. Not merely unused: under
#                   QT_OPENGL=angle the app dies with 0xC0000005, and under
#                   QT_OPENGL=software it draws a black screen. They cannot help.
# imageformats keeps qjpeg only: PNG and BMP are built into QtGui (which is why
# no qpng/qbmp plugin exists), and jpg is one of the offered screenshot formats.

set(DROP_DIRS bearer iconengines networkinformation tls)
set(DROP_FILES
	Qt5Svg.dll Qt6Svg.dll
	D3Dcompiler_47.dll libEGL.dll libGLESv2.dll opengl32sw.dll
)
set(KEEP_IMAGEFORMATS qjpeg.dll)

foreach(d ${DROP_DIRS})
	file(REMOVE_RECURSE "${CMAKE_INSTALL_PREFIX}/${d}")
endforeach()

foreach(f ${DROP_FILES})
	file(REMOVE "${CMAKE_INSTALL_PREFIX}/${f}")
endforeach()

file(GLOB imgplugins "${CMAKE_INSTALL_PREFIX}/imageformats/*.dll")
foreach(f ${imgplugins})
	get_filename_component(n "${f}" NAME)
	if(NOT n IN_LIST KEEP_IMAGEFORMATS)
		file(REMOVE "${f}")
	endif()
endforeach()

endif()

# What windeployqt leaves out: the DLLs the program, Qt and its plugins import that are
# neither Qt's nor the system's. With the Qt installer's MinGW there are none left; with
# MSYS2's Qt (win-arm64) they are libc++, ICU, harfbuzz, freetype and the rest. Each is
# taken from beside Qt or the compiler; one found nowhere stops the install here rather
# than on a user's machine.
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "objdump")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "@CMAKE_OBJDUMP@")
file(GLOB_RECURSE dlls "${CMAKE_INSTALL_PREFIX}/*.dll")
file(GET_RUNTIME_DEPENDENCIES
	EXECUTABLES "${APP}"
	LIBRARIES ${dlls}
	DIRECTORIES "${CMAKE_INSTALL_PREFIX}" "@QT_BIN_DIR@" "@CXX_BIN_DIR@" "$ENV{SystemRoot}/System32"
	PRE_EXCLUDE_REGEXES "^api-ms-" "^ext-ms-"
	POST_EXCLUDE_REGEXES "[/\\\\][Ss]ystem32[/\\\\]"
	RESOLVED_DEPENDENCIES_VAR found
	UNRESOLVED_DEPENDENCIES_VAR missing
)
if(missing)
	message(FATAL_ERROR "DLLs found nowhere: ${missing}")
endif()
file(TO_CMAKE_PATH "${CMAKE_INSTALL_PREFIX}/" prefix)	# --prefix may come with backslashes
string(TOLOWER "${prefix}" prefix)
foreach(f ${found})
	string(TOLOWER "${f}" lf)
	string(FIND "${lf}" "${prefix}" at)
	if(NOT at EQUAL 0)
		message(STATUS "Bundling ${f}")
		file(COPY "${f}" DESTINATION "${CMAKE_INSTALL_PREFIX}")
	endif()
endforeach()

# The licenses of what MSYS2 gave (win-arm64): every package that installed a DLL now in
# the folder - Qt, its plugins, SDL2, libc++, ICU and the rest - brings its texts from
# share/licenses into licenses\, and licenses\packages.txt names each package with its
# version and license. The Qt installer's Qt has no pacman database: nothing to do there.
get_filename_component(msys_env "@CXX_BIN_DIR@" DIRECTORY)	# C:/msys64/clangarm64
get_filename_component(msys_root "${msys_env}" DIRECTORY)
get_filename_component(env_name "${msys_env}" NAME)
set(pacdb "${msys_root}/var/lib/pacman/local")
if(EXISTS "${pacdb}")
	set(lic "${CMAKE_INSTALL_PREFIX}/licenses")
	file(REMOVE_RECURSE "${lic}")
	file(GLOB_RECURSE staged "${CMAKE_INSTALL_PREFIX}/*.dll")
	set(want "")
	foreach(f ${staged})
		get_filename_component(n "${f}" NAME)
		string(TOLOWER "${n}" n)
		list(APPEND want "${n}")
	endforeach()
	set(index "These come from MSYS2 packages (https://packages.msys2.org). Each one's license texts are in the folders named after it.\n\n")
	set(bare "")
	file(GLOB pkgs LIST_DIRECTORIES true "${pacdb}/*")
	foreach(p ${pkgs})
		if(NOT EXISTS "${p}/files" OR NOT EXISTS "${p}/desc")
			continue()
		endif()
		file(STRINGS "${p}/files" lines REGEX "^${env_name}/.*[.]dll$")
		set(owns OFF)
		foreach(l ${lines})
			get_filename_component(n "${l}" NAME)
			string(TOLOWER "${n}" n)
			if(n IN_LIST want)
				set(owns ON)
				break()
			endif()
		endforeach()
		if(NOT owns)
			continue()
		endif()
		# desc: "%NAME%", "%VERSION%", "%LICENSE%"... each followed by its lines
		file(STRINGS "${p}/desc" desc)
		set(sect "")
		set(d_NAME "")
		set(d_VERSION "")
		set(d_LICENSE "")
		foreach(l ${desc})
			if(l MATCHES "^%([A-Z]+)%$")
				set(sect "${CMAKE_MATCH_1}")
			elseif(sect STREQUAL "NAME" OR sect STREQUAL "VERSION" OR sect STREQUAL "LICENSE")
				list(APPEND d_${sect} "${l}")
			endif()
		endforeach()
		file(STRINGS "${p}/files" texts REGEX "^${env_name}/share/licenses/.*[^/]$")
		set(dirs "")
		foreach(t ${texts})
			string(REGEX REPLACE "^${env_name}/share/licenses/" "" rel "${t}")
			get_filename_component(sub "${rel}" DIRECTORY)
			file(COPY "${msys_root}/${t}" DESTINATION "${lic}/${sub}")
			string(REGEX REPLACE "/.*" "" top "${rel}")
			list(APPEND dirs "${top}")
		endforeach()
		if(NOT texts)
			# a package that keeps its text elsewhere (ICU: share/icu/<version>/LICENSE)
			file(STRINGS "${p}/files" texts REGEX "^${env_name}/.*/(LICEN[CS]E|COPYING|NOTICE)[^/]*$")
			string(REGEX REPLACE "^mingw-w64-(clang-aarch64|clang-x86_64|ucrt-x86_64|x86_64|i686)-" "" short "${d_NAME}")
			foreach(t ${texts})
				file(COPY "${msys_root}/${t}" DESTINATION "${lic}/${short}")
				list(APPEND dirs "${short}")
			endforeach()
		endif()
		list(REMOVE_DUPLICATES dirs)
		string(REPLACE ";" " AND " d_LICENSE "${d_LICENSE}")
		string(REPLACE ";" ", " dirs "${dirs}")
		if(NOT dirs)
			set(dirs "(no text in the package)")
			list(APPEND bare "${d_NAME}")
		endif()
		string(APPEND index "${d_NAME} ${d_VERSION} - ${d_LICENSE}: ${dirs}\n")
		message(STATUS "License of ${d_NAME}: ${d_LICENSE} -> ${dirs}")
	endforeach()
	file(WRITE "${lic}/packages.txt" "${index}")
	if(bare)
		message(WARNING "MSYS2 packages with no license text: ${bare}")
	endif()
endif()
