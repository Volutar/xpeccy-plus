; TR-DOS labels for the Xpeccy+ debugger.
;
; Names and data ranges from "TR-DOS Disassembled" by Marcos Cruz
; (programandala.net), 2016-2017 (https://github.com/programandala-net/tr-dos, commit
; 3f58896b, 2023-10-31): trdos.symbols.input.z80s, inc/zx_spectrum_trdos_addresses.z80s,
; trdos.blocks.txt. Used with his permission (e-mail of 2026-11-08: "you can use the
; labels and any other material from my TR-DOS 5.03 dissassembly in any way you need").
;
; Changed for Xpeccy+ on 2026-11-08: names in capitals, a dot written as an
; underscore (cli_command.cat as CLI_COMMAND_CAT), as the debugger takes them;
; cli_command.gosub renamed CLI_COMMAND_LOAD, the handler his own table gives the
; LOAD token; message.insert_destination_disk moved from #2725, inside an
; instruction, to #2785, where that text is; the message, token and title blocks
; shown as text.
;
; This list: TR-DOS 5.03 and the patched copies with its code at the same places.
;
; Converted to the Debugger's text format on 2026-11-20 (docs/debugger-format.md):
; rom NAME <MD5 of a 16K bank> [skip what that bank has not], the bundled images
; above it; NAME:ADDR LABEL a name; db/dw/da/dm/dc NAME:ADDR LENGTH data, N*K for
; K statements of N.
; phoenix.rom bank 1, profi-kramis02.rom bank 1
rom TRDOS_503 0c42e3b9ab8dd91ea096f1d0c07c55e5
; 256s-3.rom
rom TRDOS_503 ce0723f9bc02f4948c15d3b3230ae831 skip TRDOS.RST_18 TRDOS.NOT_USED_0033 TRDOS.NOT_USED_0805 TRDOS.NOT_USED_16F9 TRDOS.MAGIC_BUTTON_NMI_REQUEST TRDOS.NOT_USED_31FD TRDOS.NOT_USED_3FF0 TRDOS_503:0033-0039 TRDOS_503:0805-0FFF TRDOS_503:31FD-3CF9 TRDOS_503:3FF0-3FFF
; atm2.rom bank 1
rom TRDOS_503 26b2b42ffa5490275090c087b949a987 skip TRDOS.NOT_USED_0033 TRDOS.NOT_USED_0805 TRDOS.NOT_USED_16F9 TRDOS.NOT_USED_31FD TRDOS.NOT_USED_3FF0 TRDOS_503:0805-0FFF TRDOS_503:31FD-3CF9 TRDOS_503:3FF0-3FFF
; profi-bios10.rom bank 1, profi-bios20.rom bank 1, trdos504t.rom, tsconf.rom bank 1
rom TRDOS_503 b4c9634312b796063015450daef13dfa skip TRDOS.NOT_USED_0033 TRDOS.NOT_USED_0805 TRDOS.NOT_USED_16F9 TRDOS.NOT_USED_31FD TRDOS.NOT_USED_3FF0 TRDOS_503:0360-03AB TRDOS_503:0805-0FFF TRDOS_503:31FD-3CF9
; scorpion295.rom bank 3
rom TRDOS_503 e522f5c4e2fd9c735f4a2a79f66c7c89 skip TRDOS.RST_18 TRDOS.NOT_USED_0033 TRDOS.NOT_USED_0805 TRDOS.NOT_USED_16F9 TRDOS.MAGIC_BUTTON_NMI_REQUEST TRDOS.NOT_USED_31FD TRDOS.NOT_USED_3FF0 TRDOS_503:0033-0039 TRDOS_503:0805-0FFF TRDOS_503:16F9-170F TRDOS_503:31FD-3CF9 TRDOS_503:3FF0-3FFF
; trdos.rom
rom TRDOS_503 0da70a5d2a0e733398e005b96b7e4ba6 skip TRDOS.NOT_USED_0033 TRDOS.NOT_USED_0805 TRDOS.NOT_USED_16F9 TRDOS.NOT_USED_31FD TRDOS.TRY_B_AS_STEP_RATE_OF_TEMPORARY_DRIVE TRDOS.NOT_USED_3FF0
; zxevo-fe.rom bank 29
rom TRDOS_503 7d8aa7d31bed0380faef83a75bfee7c9 skip TRDOS.RST_10 TRDOS.RST_18 TRDOS.RST_20 TRDOS.NOT_USED_0033 TRDOS.DO_INTERPRET_REM_COMMAND_IN_BASIC TRDOS.TRDOS_TITLE TRDOS.NOT_USED_0805 TRDOS.MESSAGE_INTERFACE_1 TRDOS.NOT_USED_16F9 TRDOS.PRINT_NUMBER_IN_BC TRDOS.WRITE_SECTORS TRDOS.TABLE_C_COMMANDS TRDOS.NOT_USED_31FD TRDOS.PRINT_CHARACTER_A TRDOS.TRY_B_AS_STEP_RATE_OF_TEMPORARY_DRIVE TRDOS.NOT_USED_3FF0 TRDOS_503:0033-0039 TRDOS_503:0360-03AB TRDOS_503:0805-0FFF TRDOS_503:1000-1017 TRDOS_503:288C TRDOS_503:288D-288E TRDOS_503:288F TRDOS_503:2890-2891 TRDOS_503:2892 TRDOS_503:2893-2894 TRDOS_503:2895 TRDOS_503:2896-2897 TRDOS_503:2898 TRDOS_503:2899-289A TRDOS_503:289B TRDOS_503:289C-289D TRDOS_503:289E TRDOS_503:289F-28A0 TRDOS_503:28A1 TRDOS_503:28A2-28A3 TRDOS_503:28A4 TRDOS_503:28A5-28A6 TRDOS_503:28A7 TRDOS_503:28A8-28A9 TRDOS_503:28AA TRDOS_503:28AB-28AC TRDOS_503:28AD TRDOS_503:28AE-28AF TRDOS_503:28B0 TRDOS_503:28B1-28B2 TRDOS_503:28B3 TRDOS_503:28B4-28B5 TRDOS_503:28B6 TRDOS_503:28B7-28B8 TRDOS_503:28B9 TRDOS_503:28BA-28BB TRDOS_503:28BC TRDOS_503:28BD-28BE TRDOS_503:28BF TRDOS_503:28C0-28C1 TRDOS_503:28C2 TRDOS_503:28C3-28C4 TRDOS_503:28C5 TRDOS_503:28C6-28C7 TRDOS_503:28C8 TRDOS_503:28C9-28CA TRDOS_503:28CB TRDOS_503:28CC-28CD TRDOS_503:28CE TRDOS_503:28CF-28D0 TRDOS_503:28D1 TRDOS_503:28D2-28D3 TRDOS_503:28D4 TRDOS_503:28D5-28D6 TRDOS_503:31FD-3CF9 TRDOS_503:3FF0-3FFF
