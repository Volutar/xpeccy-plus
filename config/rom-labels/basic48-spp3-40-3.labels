; Converted to the Debugger's text format on 2026-11-20 (docs/debugger-format.md):
; rom NAME <MD5 of a 16K bank> [skip what that bank has not], the bundled images
; above it; NAME:ADDR LABEL a name; db/dw/da/dm/dc NAME:ADDR LENGTH data, N*K for
; K statements of N.
; plus3-3.rom
rom BASIC48_SPP3_40_3 a148bcc575e51389e84fdf5d555c3196
; plus3-41.rom bank 3
rom BASIC48_SPP3_40_3 ef7bf942a1c1f9ed5d583d0a49e26db7
BASIC48_SPP3_40_3:3A29 BASIC48.HOOK_REPORT
BASIC48_SPP3_40_3:3A34 BASIC48.HOOK_TO_010F
BASIC48_SPP3_40_3:3A3B BASIC48.HOOK_STMT_JUMP
BASIC48_SPP3_40_3:3A46 BASIC48.HOOK_TO_0112
BASIC48_SPP3_40_3:3A4B BASIC48.HOOK_STMT_NEXT
BASIC48_SPP3_40_3:3A55 BASIC48.HOOK_TO_0115
