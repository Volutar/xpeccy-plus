; Converted to the Debugger's text format on 2026-11-20 (docs/debugger-format.md):
; rom NAME <MD5 of a 16K bank> [skip what that bank has not], the bundled images
; above it; NAME:ADDR LABEL a name; db/dw/da/dm/dc NAME:ADDR LENGTH a data range.
; 128-1.rom, 128p-1.rom, phoenix.rom bank 3, phoenix-07.rom bank 7, profi-bios20.rom bank 3, profi-kramis02.rom bank 3, tsconf.rom bank 3
rom BASIC48_SP128_1 6e09e5d3c4aef166601669feaaadc01c
; 256s-1.rom, scorpion295.rom bank 1
rom BASIC48_SP128_1 643861ad34831b255bf2eb64e8b6ecb8 skip BASIC48.UNUSED_ZEROS BASIC48.UNUSED_TAIL BASIC48_SP128_1:3C8F
; atm2.rom bank 0
rom BASIC48_SP128_1 25e7ad37544091af7b82c4727e0bfc4f skip BASIC48.UNUSED_ZEROS BASIC48.UNUSED_TAIL BASIC48_SP128_1:3C8F
; plus2-1.rom
rom BASIC48_SP128_1 b3db95931cc844efaeb82db9c171b9f3 skip BASIC48.UNUSED_ZEROS BASIC48.UNUSED_TAIL
; prof39f.rom bank 1, prof401.rom bank 1
rom BASIC48_SP128_1 fbca50eff4937afde90dd9e55387d9e6 skip BASIC48.UNUSED_ZEROS BASIC48.UNUSED_TAIL BASIC48_SP128_1:3C8F
; profi-bios10.rom bank 3, zxevo-fe.rom bank 5
rom BASIC48_SP128_1 8e376009d0b6712f63fa6da672791574 skip BASIC48.UNUSED_ZEROS BASIC48.UNUSED_TAIL
; zxevo-fe.rom bank 12
rom BASIC48_SP128_1 fe2b1ca850ea0ffec5d1dac4b79dbfb8 skip BASIC48.UNUSED_ZEROS BASIC48.UNUSED_TAIL BASIC48_SP128_1:3C8F
; zxevo-fe.rom bank 28
