; The above copyright notice and this permission notice shall be included in all
; copies or substantial portions of the Software.
; THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
; IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
; FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
; AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
; LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
; OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
; SOFTWARE.
;
; Changed for Xpeccy+ on 2026-11-13: data ranges from his DEFB and DEFS (db), DEFW
; (da) and DEFM (text) lines; a message's last character (DEFB 'x'+$80) and the (c)
; sign before one ($7F) as part of its text.
;
; @rom <MD5 of a 16K bank> <bundled image> [-NAME / -@ADDR: not in that bank]
; ADDR NAME: a name; START END VIEW: a data range
@ns BASIC128
@rom b4d2692115a9f2924df92a3cbfb358fb 128-0.rom, zxevo-fe.rom bank 6
@rom a249565f03b98d004ee7f019570069cd 128p-0.rom, atm2.rom bank 2, profi-bios10.rom bank 2, profi-bios20.rom bank 2, profi-kramis02.rom bank 2, tsconf.rom bank 2, zxevo-fe.rom bank 10, zxevo-fe.rom bank 30 -RS232_BIT_LOOP_2 -CAT_LOW_NAME -MENU_TAPE_TEST -BLANK_ROW -TAPE_TESTER -TAPE_MARKS_LOOP -TAPE_TEST_LOOP -TAPE_SAMPLE -@275E
@rom b9fda5b6a747ff037365b0e2d8c4379a 256s-0.rom, scorpion295.rom bank 0 -START -START_DELAY -COPYRIGHT_MSG -RS232_BIT_LOOP_2 -RS232_OUT -RS232_WAIT_READY -RS232_OUT_BIT -RS232_OUT_1 -RS232_OUT_WAIT -CAT_LOW_NAME -MENU_ACTIONS -MAIN_MENU_ITEMS -BLANK_ROW -TITLE_128_BASIC -TITLE_CALC -TITLE_TAPE_LOAD -TITLE_TAPE_TEST -TAPE_TESTER -TAPE_MARKS_LOOP -TAPE_TEST_LOOP -TAPE_SAMPLE -TAPE_LEVEL -TAPE_LEVEL_LOW -TAPE_SHOW -TAPE_ROW_LOOP -@000C -@0014 -@001C -@0024 -@048C -@2746 -@2752 -@275E
@rom 97da465c399ff70b907dfd8291e8f9d3 phoenix.rom bank 2 -RS232_BIT_LOOP_2 -CAT_LOW_NAME -MENU_ACTIONS -MAIN_MENU_ITEMS -MENU_TAPE_TEST -BLANK_ROW -TITLE_128_BASIC -TITLE_CALC -TITLE_TAPE_LOAD -TAPE_TESTER -TAPE_MARKS_LOOP -TAPE_TEST_LOOP -TAPE_SAMPLE -TAPE_LEVEL -@2746 -@2749 -@274C -@274F -@2752 -@275E
@rom 3d73e462011ba73f2e746fcd0c79e86f prof39f.rom bank 0, prof401.rom bank 0 -START -START_DELAY -COPYRIGHT_MSG -RS232_BIT_LOOP_2 -RS232_OUT -RS232_WAIT_READY -RS232_OUT_BIT -RS232_OUT_1 -RS232_OUT_WAIT -CAT_LOW_NAME -MENU_ACTIONS -MAIN_MENU_ITEMS -BLANK_ROW -TITLE_128_BASIC -TITLE_CALC -TITLE_TAPE_LOAD -TITLE_TAPE_TEST -TAPE_TESTER -TAPE_MARKS_LOOP -TAPE_TEST_LOOP -TAPE_SAMPLE -TAPE_LEVEL -TAPE_LEVEL_LOW -TAPE_SHOW -TAPE_ROW_LOOP -@000C -@0014 -@001C -@0024 -@048C -@2746 -@2752 -@275E
@rom 850bb46b3dd5a7be5500a45f1db4d516 zxevo-fe.rom bank 14 -START -START_DELAY -COPYRIGHT_MSG -RS232_BIT_LOOP_2 -RS232_OUT -RS232_WAIT_READY -RS232_OUT_BIT -RS232_OUT_1 -RS232_OUT_WAIT -CAT_LOW_NAME -MENU_ACTIONS -MAIN_MENU_ITEMS -BLANK_ROW -TITLE_128_BASIC -TITLE_CALC -TITLE_TAPE_LOAD -TITLE_TAPE_TEST -TAPE_TESTER -TAPE_MARKS_LOOP -TAPE_TEST_LOOP -TAPE_SAMPLE -TAPE_LEVEL -TAPE_LEVEL_LOW -TAPE_SHOW -TAPE_ROW_LOOP -@000C -@0014 -@001C -@0024 -@048C -@2746 -@2752 -@275E
