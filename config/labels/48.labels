@rom ef7bf942a1c1f9ed5d583d0a49e26db7 plus3-41.rom bank 3 -KEY_INT -CASSETTE -PO_T_UDG -P_SAVE -P_INK -P_PAPER -P_FLASH -STMT_R_1 -STMT_NEXT -LAST -CHARSET -@0013 -@09A2 -@1392 -@386E
