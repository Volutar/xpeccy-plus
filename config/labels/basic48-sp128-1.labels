; @rom <MD5 of a 16K bank> <bundled image> [-NAME / -@ADDR: not in that bank]
; ADDR NAME: a name; START END VIEW: a data range
@ns BASIC48
@rom 6e09e5d3c4aef166601669feaaadc01c 128-1.rom, 128p-1.rom, phoenix.rom bank 3, profi-bios20.rom bank 3, profi-kramis02.rom bank 3, tsconf.rom bank 3
@rom 643861ad34831b255bf2eb64e8b6ecb8 256s-1.rom, scorpion295.rom bank 1 -UNUSED_ZEROS -UNUSED_TAIL -@3C8F
@rom 25e7ad37544091af7b82c4727e0bfc4f atm2.rom bank 0 -UNUSED_ZEROS -UNUSED_TAIL -@3C8F
@rom b3db95931cc844efaeb82db9c171b9f3 plus2-1.rom -UNUSED_ZEROS -UNUSED_TAIL
@rom fbca50eff4937afde90dd9e55387d9e6 prof39f.rom bank 1, prof401.rom bank 1 -UNUSED_ZEROS -UNUSED_TAIL -@3C8F
@rom 8e376009d0b6712f63fa6da672791574 profi-bios10.rom bank 3, zxevo-fe.rom bank 5 -UNUSED_ZEROS -UNUSED_TAIL
@rom fe2b1ca850ea0ffec5d1dac4b79dbfb8 zxevo-fe.rom bank 12 -UNUSED_ZEROS -UNUSED_TAIL -@3C8F
@rom afdb7b928f9e1d99476e13d6cac98d20 zxevo-fe.rom bank 28 -KP_SCAN2 -UNUSED_ZEROS -UNUSED_TAIL -@3BE1 -@3C8F
