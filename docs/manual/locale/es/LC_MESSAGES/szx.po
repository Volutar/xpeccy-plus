msgstr ""
"el vídeo: modo, borde, flash, pulso INT, el estado de vídeo de TSConf y "
"el búfer de línea"

msgid "`PAL `"
msgstr "`PAL `"

msgid ""
"the palette, on a machine whose palette is its own (ATM, Evo, TSConf, "
"Profi)"
msgstr "la paleta, en una máquina con paleta propia (ATM, Evo, TSConf, Profi)"

msgid "`RAY `"
msgstr "`RAY `"

msgid "`dword`: dots past the frame interrupt, more exact than `dwCyclesStart`"
msgstr ""
