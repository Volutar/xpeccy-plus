            <string>How fast the tape signal is played, in per cent of normal.
A few images made on machines with an unusual clock
load only when it is nudged either way</string>
           </property>
           <property name="minimum">
            <number>95</number>
           </property>
           <property name="maximum">
            <number>105</number>
           </property>
           <property name="pageStep">
            <number>1</number>
           </property>
           <property name="value">
            <number>100</number>
           </property>
